# ShopLite Environment Variables Example
# Copy this file to .env and fill in your actual credentials

# Database connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/shoplite

# Auth
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
SESSION_SECRET=your_session_secret_here

# Server
PORT=5001
NODE_ENV=development

# CORS / Origins
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5001

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Redirect Domain (e.g., http://localhost:5001 or https://your-site.com)
CALLBACK_DOMAIN=https://shopliteweb.onrender.com
